# Local Docker/Podman Compose only. Copy to .env at the repository root.
# Compose passes database settings to the backend containers explicitly.
DB_PASSWORD=whoshot_local
DB_PORT=5432
API_PORT=8080
FRONTEND_PORT=3000
DATA_JOB_PROFILE=local

# Linux Docker: set these to your host UID/GID (id -u / id -g).
LOCAL_UID=1000
LOCAL_GID=1000

# Production only (server .env; see infra/README.md). Leave unset locally.
# APP_PROFILE=prod
# IMAGE_TAG=<commit sha>
# GHCR_OWNER=kyozoku-des
# SITE_ADDRESS=example.com
